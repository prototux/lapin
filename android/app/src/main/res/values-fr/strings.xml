    <string name="perm_media">Accès aux notifications (facultatif)</string>
    <string name="perm_media_explain">Facultatif : permet à Lapin de savoir ce que joue n\'importe quelle appli et de piloter celle qui joue vraiment. Lapin ne lit pas tes notifications.</string>

